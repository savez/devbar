{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "journal",
  "description": "Uscita di `devbar journal [--limit N]` (lib/journal.sh cmd_journal): le modifiche registrate ai file di altri programmi, dalla più recente. Solo lettura del registro, nessun hash: se un file è cambiato dopo devbar lo dice il piano di `devbar undo` (needsForce).",
  "type": "object",
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "time",
          "command",
          "undone",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "time": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "command": {
            "type": "string"
          },
          "undone": {
            "type": "boolean"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "kind",
                "existed",
                "sha256Before",
                "sha256After"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "file",
                    "dir",
                    "link",
                    "none"
                  ]
                },
                "existed": {
                  "type": "boolean"
                },
                "sha256Before": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "sha256After": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
