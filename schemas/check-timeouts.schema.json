{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "check-timeouts",
  "description": "Timeout in secondi di ogni check di `check all` (lib/detect.sh cmd_check_timeouts). L'app ne somma i valori (StatusStore.checkTimeouts).",
  "type": "object",
  "required": ["brew-outdated", "brew-vulns", "npm-audit", "composer-audit", "colima", "rtk", "tokensave", "tokeneconomizer", "caveman", "claude-usage", "harnesses"],
  "properties": {
    "brew-outdated": { "$ref": "#/$defs/secs" },
    "brew-vulns": { "$ref": "#/$defs/secs" },
    "npm-audit": { "$ref": "#/$defs/secs" },
    "composer-audit": { "$ref": "#/$defs/secs" },
    "colima": { "$ref": "#/$defs/secs" },
    "rtk": { "$ref": "#/$defs/secs" },
    "tokensave": { "$ref": "#/$defs/secs" },
    "tokeneconomizer": { "$ref": "#/$defs/secs" },
    "caveman": { "$ref": "#/$defs/secs" },
    "claude-usage": { "$ref": "#/$defs/secs" },
    "harnesses": { "$ref": "#/$defs/secs" }
  },
  "additionalProperties": false,
  "$defs": { "secs": { "type": "integer", "minimum": 1 } }
}
