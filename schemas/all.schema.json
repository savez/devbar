{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "check all",
  "description": "Aggregato di `devbar check all` (lib/detect.sh check_all_run): una riga per check, con `rc` aggiunto dal motore. Una riga è la busta completa del check (con i suoi campi specifici) oppure, per timeout o output non valido, solo {rc,status,summary}. Se un altro giro tiene il lock risponde {status:error,error:busy}.",
  "oneOf": [
    {
      "type": "object",
      "required": ["brew-outdated", "brew-vulns", "npm-audit", "composer-audit", "colima", "rtk", "tokensave", "tokeneconomizer", "caveman", "claude-usage", "harnesses", "advisories"],
      "properties": {
        "brew-outdated": { "$ref": "#/$defs/row/brew-outdated" },
        "brew-vulns": { "$ref": "#/$defs/row/brew-vulns" },
        "npm-audit": { "$ref": "#/$defs/row/npm-audit" },
        "composer-audit": { "$ref": "#/$defs/row/composer-audit" },
        "colima": { "$ref": "#/$defs/row/colima" },
        "rtk": { "$ref": "#/$defs/row/rtk" },
        "tokensave": { "$ref": "#/$defs/row/tokensave" },
        "tokeneconomizer": { "$ref": "#/$defs/row/tokeneconomizer" },
        "caveman": { "$ref": "#/$defs/row/caveman" },
        "claude-usage": { "$ref": "#/$defs/row/claude-usage" },
        "harnesses": { "$ref": "#/$defs/row/harnesses" },
        "advisories": { "$ref": "#/$defs/row/advisories" }
      },
      "additionalProperties": false
    },
    { "$ref": "defs.schema.json#/$defs/engineError" }
  ],
  "$defs": {
    "row": {
      "brew-outdated": { "anyOf": [{ "allOf": [{ "$ref": "brew-outdated.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "brew-vulns": { "anyOf": [{ "allOf": [{ "$ref": "brew-vulns.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "npm-audit": { "anyOf": [{ "allOf": [{ "$ref": "npm-audit.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "composer-audit": { "anyOf": [{ "allOf": [{ "$ref": "composer-audit.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "colima": { "anyOf": [{ "allOf": [{ "$ref": "colima.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "rtk": { "anyOf": [{ "allOf": [{ "$ref": "rtk.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "tokensave": { "anyOf": [{ "allOf": [{ "$ref": "tokensave.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "tokeneconomizer": { "anyOf": [{ "allOf": [{ "$ref": "tokeneconomizer.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "caveman": { "anyOf": [{ "allOf": [{ "$ref": "caveman.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "claude-usage": { "anyOf": [{ "allOf": [{ "$ref": "claude-usage.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "harnesses": { "anyOf": [{ "allOf": [{ "$ref": "harnesses.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] },
      "advisories": { "anyOf": [{ "allOf": [{ "$ref": "advisories.schema.json" }, { "required": ["rc"] }] }, { "$ref": "defs.schema.json#/$defs/checkFailureRow" }] }
    }
  }
}
